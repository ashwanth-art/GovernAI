# Optional model review. Only redacted public observations and explicitly opted-in
# documents are sent. Missing model credentials do not block deterministic checks.
OPENAI_API_KEY=
REVIEW_MODEL_SMALL=gpt-4.1-mini
REVIEW_MODEL_COMPLEX=gpt-4.1

# Node review worker: dedicated managed PostgreSQL and private Azure Blob storage.
# Generate each key independently with openssl rand -hex 32. Keep them stable:
# rotating encryption without re-encryption makes saved records unreadable.
REVIEW_DATABASE_URL=
REVIEW_ENCRYPTION_KEY=
REVIEW_SESSION_KEY=
REVIEW_STORAGE_CONNECTION_STRING=
REVIEW_EVIDENCE_CONTAINER=review-evidence
REVIEW_CHROMIUM_PATH=/usr/bin/chromium
# Optional API OIDC. Without it the workspace uses isolated signed demo sessions.
REVIEW_OIDC_ISSUER=
REVIEW_OIDC_AUDIENCE=
REVIEW_OIDC_JWKS_URL=

# Development only. Allows GovernAI to assess a locally running target such as
# http://127.0.0.1:8000. This is ignored in production.
GOVERNAI_ALLOW_LOCAL_TARGETS=false
